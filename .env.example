# Google Gemini API Key - Server-Side Only
# Never prefix with VITE_ to prevent leaking credentials to client bundles
GEMINI_API_KEY=your_gemini_api_key_here

# Authentication HMAC Secret - Mandatory for Cloud Authentication in Production
# Generate a high-entropy string (e.g., openssl rand -hex 32)
AUTH_SECRET=your_super_secure_random_auth_secret_at_least_32_chars

# Optional Remote Cloud Synchronization Endpoint (REST or Peer Sync)
VITE_REMOTE_SYNC_URL=https://sync.example.com/api/v1
